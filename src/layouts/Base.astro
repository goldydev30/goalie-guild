---
import { url } from '../lib/url';
import { sections, contact } from '../data/sections';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  current?: string;
}

const {
  title,
  description = 'The Goalie Guild: a nonprofit for ice hockey goaltenders, with scholarships, the GGR, Lift The Mask and resources for goalies and coaches.',
  current,
} = Astro.props;
const pageTitle = title ? `${title} · The Goalie Guild` : 'The Goalie Guild';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@400;500;600&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap"
    />
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="wrap nav" aria-label="Main">
        <a href={url('/')} class="brand display">The Goalie Guild</a>
        <ul class="nav-links">
          {sections.map((s) => (
            <li>
              <a href={url(s.path)} aria-current={current === s.key ? 'page' : undefined}>{s.title}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-row">
        <span class="display">The Goalie Guild</span>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
        <a href={contact.instagram}>Instagram</a>
        <a href={contact.facebook}>Facebook</a>
        <a href={contact.liftTheMask}>Lift The Mask</a>
        <a href={contact.candid}>Candid profile</a>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header { border-bottom: 1px solid var(--line); background: var(--panel); }
  .nav { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; padding-block: 12px; }
  .brand { color: var(--text); text-decoration: none; font-size: 20px; min-height: 44px; display: flex; align-items: center; }
  .nav-links { list-style: none; margin: 0 0 0 auto; padding: 0; display: flex; flex-wrap: wrap; gap: 2px; }
  .nav-links a {
    display: block; padding: 12px 12px; color: var(--text-2); text-decoration: none;
    font-family: var(--font-ui); font-size: 14px; font-weight: 500;
    border-bottom: 2px solid transparent;
  }
  .nav-links a:hover { color: var(--accent); }
  .nav-links a[aria-current='page'] { color: var(--accent); border-bottom-color: var(--accent); }
  .site-footer { border-top: 1px solid var(--line); margin-top: 96px; }
  .footer-row {
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px;
    padding-block: 40px; font-family: var(--font-ui); font-size: 14px; color: var(--muted);
  }
  .footer-row .display { color: var(--text); font-size: 16px; margin-right: auto; }
  @media (max-width: 760px) { .nav-links { margin-left: -12px; } }
</style>
